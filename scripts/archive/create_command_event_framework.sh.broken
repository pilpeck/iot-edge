#!/usr/bin/env bash

set -euo pipefail

echo "==========================================="
echo " Creating Command and Event Framework"
echo "==========================================="

# Confirm this script is running from the project root.
if [[ ! -d "engine" || ! -d "devices" ]]; then
    echo "ERROR: Run this script from the iot-edge project root."
    echo "Expected directories: engine/ and devices/"
    exit 1
fi

mkdir -p engine tests

touch engine/__init__.py
touch tests/__init__.py

#########################################################
# Command model
#########################################################

cat > engine/command.py <<'PYTHON'
from dataclasses import dataclass, field
from typing import Any
from uuid import uuid4


@dataclass(frozen=True)
class Command:
    device_id: str
    capability: str
    arguments: dict[str, Any] = field(default_factory=dict)
    command_id: str = field(
        default_factory=lambda: str(uuid4())
    )
PYTHON

#########################################################
# Command result model
#########################################################

cat > engine/command_result.py <<'PYTHON'
from dataclasses import dataclass
from typing import Any


@dataclass(frozen=True)
class CommandResult:
    command_id: str
    device_id: str
    capability: str
    success: bool
    result: Any = None
    error: str | None = None
PYTHON

#########################################################
# Event model
#########################################################

cat > engine/event.py <<'PYTHON'
from dataclasses import dataclass, field
from datetime import datetime, timezone
from typing import Any
from uuid import uuid4


@dataclass(frozen=True)
class Event:
    event_type: str
    source: str
    data: dict[str, Any] = field(default_factory=dict)
    event_id: str = field(
        default_factory=lambda: str(uuid4())
    )
    timestamp: str = field(
        default_factory=lambda: datetime.now(
            timezone.utc
        ).isoformat()
    )
PYTHON

